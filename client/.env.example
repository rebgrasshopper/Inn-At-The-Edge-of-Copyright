# Client Environment Variables
# Copy this file to .env.local and customize as needed

# API base URL (defaults to /api which uses Vite proxy in development)
# For ngrok mobile testing, set to your ngrok URL: https://abc123.ngrok-free.app/api
VITE_API_URL=

# Socket.io server URL (defaults to same origin)
# For ngrok mobile testing, set to your ngrok URL: https://abc123.ngrok-free.app
VITE_SOCKET_URL=
