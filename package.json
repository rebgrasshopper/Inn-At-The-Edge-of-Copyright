{
  "name": "mud-game",
  "version": "1.0.0",
  "description": "A text-based MUD (Multi-User Dungeon) game with Pathfinder RPG vibes",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "npm run dev --prefix client",
    "build": "tsc && npm run build --prefix client",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "tsx scripts/e2e-test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "mud",
    "game",
    "multiplayer",
    "websocket",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "obscenity": "^0.4.6",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.2.4",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "fast-check": "^4.5.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
